@inject ITransactionService Transactions
@inject IJSRuntime JS

<section class="panel form-panel" aria-labelledby="transaction-form-title">
    <h2 id="transaction-form-title">@(IsNew ? "ثبت تراکنش جدید" : "ویرایش تراکنش")</h2>
    <form @onsubmit="Save" @onsubmit:preventDefault novalidate>
        <fieldset disabled="@busy">
            <div class="segmented" role="group" aria-label="نوع تراکنش">
                <button type="button" class="@(Model.Type == TransactionType.Inflow ? "selected" : "")" aria-pressed="@(Model.Type == TransactionType.Inflow)" @onclick="() => Model.Type = TransactionType.Inflow">↓ ورود به کارگاه</button>
                <button type="button" class="@(Model.Type == TransactionType.Outflow ? "selected" : "")" aria-pressed="@(Model.Type == TransactionType.Outflow)" @onclick="() => Model.Type = TransactionType.Outflow">↑ مصرف مصالح</button>
            </div>
            <div class="form-grid">
                <div class="field"><label for="transaction-material">مصالح <span class="required">الزامی</span></label><select id="transaction-material" @bind="Model.MaterialId"><option value="@Guid.Empty">انتخاب مصالح</option>@foreach (var material in Materials) { <option value="@material.Id">@material.Name (@material.Unit)</option> }</select></div>
                <div class="field"><label for="transaction-quantity">مقدار <span class="required">الزامی</span></label><input id="transaction-quantity" type="text" inputmode="decimal" dir="ltr" @bind="quantity" /><small>واحد: @(Materials.FirstOrDefault(item => item.Id == Model.MaterialId)?.Unit ?? "ابتدا مصالح را انتخاب کنید")</small></div>
                <JalaliDateInput Id="transaction-date" Label="تاریخ تراکنش" @bind-Value="date" />
                <div class="field"><label for="transaction-document">شمارهٔ حواله یا فاکتور</label><input id="transaction-document" @bind="Model.DocumentNumber" /></div>
                @if (Model.Type == TransactionType.Inflow)
                {
                    <div class="field"><label for="seller-name">نام فروشنده</label><input id="seller-name" @bind="Model.SellerName" /></div>
                    <div class="field"><label for="seller-phone">تلفن فروشنده</label><input id="seller-phone" type="tel" inputmode="numeric" dir="ltr" autocomplete="tel" @bind="Model.SellerPhone" /></div>
                    <div class="field"><label for="driver-name">نام راننده</label><input id="driver-name" @bind="Model.DriverName" /></div>
                    <div class="field"><label for="driver-phone">تلفن راننده</label><input id="driver-phone" type="tel" inputmode="numeric" dir="ltr" @bind="Model.DriverPhone" /></div>
                }
                else
                {
                    <div class="field"><label for="work-area">محل مصرف <span class="required">الزامی</span></label><input id="work-area" @bind="Model.WorkArea" placeholder="مانند سرویس طبقهٔ دوم" /></div>
                    <div class="field"><label for="purpose">شرح مصرف</label><input id="purpose" @bind="Model.Purpose" /></div>
                }
                <div class="field wide"><label for="transaction-notes">یادداشت</label><textarea id="transaction-notes" @bind="Model.Notes" rows="2"></textarea></div>
            </div>
            @if (error is not null) { <p class="alert error" role="alert">@error</p> }
            <div class="actions"><button type="submit" class="button primary">@(busy ? "در حال ذخیره…" : "ذخیرهٔ تراکنش")</button><button type="button" class="button secondary" @onclick="() => OnCancel.InvokeAsync()">انصراف</button></div>
        </fieldset>
    </form>
</section>

@code {
    [Parameter, EditorRequired] public MaterialTransaction Model { get; set; } = new();
    [Parameter] public IReadOnlyList<Material> Materials { get; set; } = [];
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private bool busy;
    private string quantity = string.Empty;
    private string date = string.Empty;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        quantity = IsNew ? string.Empty : PersianText.Number(Model.Quantity);
        if (IsNew)
        {
            try { Model.Date = DateOnly.ParseExact(await JS.InvokeAsync<string>("sitepack.today"), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture); }
            catch (JSException) { error = "تاریخ امروز دریافت نشد. تاریخ را دستی وارد کنید."; return; }
        }
        date = PersianDate.Format(Model.Date);
    }
    private async Task Save()
    {
        busy = true;
        error = null;
        try
        {
            Model.Quantity = PersianText.ParseDecimal(quantity, "مقدار");
            Model.Date = PersianDate.Parse(date);
            if (!IsNew && !await JS.InvokeAsync<bool>("confirm", "تغییرات این تراکنش ذخیره شود؟")) return;
            await Transactions.SaveAsync(Model, IsNew);
            await OnSaved.InvokeAsync();
        }
        catch (SitePackDataException exception) { error = exception.Message; }
        catch (JSException) { error = "نمایش تأیید ممکن نشد. تغییری ذخیره نشد."; }
        finally { busy = false; }
    }
}
